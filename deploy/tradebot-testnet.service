# systemd unit for a 1–3 month testnet run on a Linux VPS.
#   sudo cp deploy/tradebot-testnet.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tradebot-testnet
#   journalctl -u tradebot-testnet -f
[Unit]
Description=AI trading bot (TESTNET)
After=network-online.target
Wants=network-online.target

[Service]
User=tradebot
WorkingDirectory=/opt/AI-bot-trade-101
EnvironmentFile=/etc/tradebot.env
ExecStart=/opt/AI-bot-trade-101/.venv/bin/python -m tradebot live \
    --broker ccxt --exchange bybit --symbol BTC/USDT:USDT --timeframe 1h \
    --policy data/runs/btc_policy.json --ai
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
