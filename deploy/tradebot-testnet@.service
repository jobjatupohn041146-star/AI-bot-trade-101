# One testnet bot per symbol, strategy #1 (structure + EMA + 4h bias, RR 1:3, 0.5% risk).
#   sudo cp deploy/tradebot-testnet@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tradebot-testnet@BTC tradebot-testnet@ETH tradebot-testnet@SOL
#   journalctl -u tradebot-testnet@BTC -f
# %i = coin, traded as the USDT perpetual on Bybit TESTNET.
[Unit]
Description=AI trading bot TESTNET %i
After=network-online.target
Wants=network-online.target

[Service]
User=tradebot
WorkingDirectory=/opt/AI-bot-trade-101
EnvironmentFile=/etc/tradebot.env
ExecStart=/opt/AI-bot-trade-101/.venv/bin/python -m tradebot live \
    --broker ccxt --exchange bybit --symbol %i/USDT:USDT --timeframe 1h \
    --strategy structure_bias,ema_bias,htf_bias --rr 3 --risk 0.5 \
    --state data/testnet/%i_state.json --db data/testnet/%i_journal.db
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
